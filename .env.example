# Runtime
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (localhost for local Node.js; Compose overrides with service DNS)
POSTGRES_DB=knowflow
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=knowflow_dev_password
DATABASE_URL=postgresql://knowflow:knowflow_dev_password@localhost:5432/knowflow?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=knowflow_redis_dev_password
REDIS_DB=0
BULLMQ_PREFIX=bull

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=knowflow_minio
MINIO_SECRET_KEY=knowflow_minio_dev_secret
MINIO_BUCKET=knowflow-documents
MAX_UPLOAD_BYTES=10485760

# MinIO root login (used by Docker Compose)
MINIO_ROOT_USER=knowflow_minio
MINIO_ROOT_PASSWORD=knowflow_minio_dev_secret

# OpenAI-compatible LLM used to generate RAG answers (set your own key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Published ports
MINIO_PUBLISHED_PORT=9000
