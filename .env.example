# Runtime
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (localhost for local Node.js; Compose overrides with service DNS)
POSTGRES_DB=knowflow
POSTGRES_USER=knowflow
POSTGRES_PASSWORD=knowflow_dev_password
DATABASE_URL=postgresql://knowflow:knowflow_dev_password@localhost:5432/knowflow?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=knowflow_redis_dev_password
REDIS_DB=0
BULLMQ_PREFIX=bull

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=knowflow_minio
MINIO_SECRET_KEY=knowflow_minio_dev_secret
MINIO_BUCKET=knowflow-documents
MAX_UPLOAD_BYTES=10485760

# MinIO root login (used by Docker Compose)
MINIO_ROOT_USER=knowflow_minio
MINIO_ROOT_PASSWORD=knowflow_minio_dev_secret

# OpenAI-compatible LLM used to generate RAG answers (set your own key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embeddings: OpenAI-compatible API or a local Transformers.js model directory
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VERSION=1
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
# Leave blank for the model's native dimension; OpenAI text-embedding-3-small defaults to 1536
EMBEDDING_DIMENSIONS=
# For EMBEDDING_PROVIDER=local, point this to a local Transformers.js-compatible ONNX model folder
EMBEDDING_LOCAL_MODEL_PATH=
EMBEDDING_LOCAL_MODEL_HOST_PATH=./models

# Independent reranker API; accepts POST /rerank with query/documents/top_n and Cohere-style results
RERANKER_PROVIDER=compatible
RERANKER_BASE_URL=http://host.docker.internal:8001/v1
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RECALL_CANDIDATE_LIMIT=50
RAG_RERANK_CANDIDATE_LIMIT=50

# Published ports
MINIO_PUBLISHED_PORT=9000
